# Copy to .env.development (npm run watch / npm run dev) and .env.production (npm run prod).

# Public URL the site is served from (used for canonical + social preview URLs)
SITE_URL=https://edrichbarnard.co.za

# Umami analytics - leave the website id empty to disable tracking entirely.
# For a self-hosted Umami, point PUBLIC_UMAMI_SRC at your instance's script.js.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
