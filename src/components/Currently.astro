---
import { site, currently } from "../data/site";
import { getContributions } from "../lib/github";
import { CELL, graphLabel, graphMarkup, graphSize, streakLabel } from "../lib/contributions";

const graph = await getContributions(site.handle);
const size = graph ? graphSize(graph) : { width: 0, height: 0 };
const streak = graph ? streakLabel(graph.streak) : "";
---

<section class="sec" id="currently" data-shape="sphere">
  <div class="wrap">
    <div class="sec-head"><span class="n">04</span><h2>Currently</h2><span class="file">now.log</span></div>
    <div class="grid-12">
      <div class="reveal col-span-12 min-[900px]:col-span-7">
        <ul class="border-t border-line" data-stagger>
          {
            currently.map((c) => (
              <li class="grid grid-cols-[90px_1fr] border-b border-line py-3.5 text-[17px]">
                <span class="pt-1 font-mono text-xs text-faint">{c.date}</span>
                {c.text}
              </li>
            ))
          }
        </ul>
        <figure id="contrib" class="mt-9" data-user={site.handle} hidden={!graph}>
          <div class="overflow-x-auto pb-1 [direction:rtl]">
            <div class="relative mr-auto w-max pt-5 [direction:ltr]">
              <span class="ph-label" data-ph-label aria-hidden="true"></span>
              <span class="ph-line" data-ph-line aria-hidden="true"></span>
              <svg
                class="block overflow-visible"
                width={size.width}
                height={size.height}
                viewBox={`0 0 ${size.width} ${size.height}`}
                role="img"
                aria-label={graph ? graphLabel(graph) : undefined}
              >
                <rect class="xh" data-xh-col x="0" y="0" width={CELL} height={7 * CELL}></rect>
                <rect class="xh" data-xh-row x="0" y="0" width={size.width} height={CELL}></rect>
                <g data-dots set:html={graph ? graphMarkup(graph) : ""} />
              </svg>
            </div>
          </div>
          <figcaption class="mt-3 flex flex-wrap justify-between gap-2 font-mono text-[11.5px] text-faint">
            <span data-contrib-caption>
              fig. 03 &mdash; <b class="font-normal text-muted"><span data-contrib-total>{graph?.total ?? 0}</span> contributions</b> on GitHub in the last year<span
                class="streak"
                data-contrib-streak>{streak && ` · ${streak}`}</span
              >
            </span>
            <span class="text-muted" data-contrib-readout hidden></span>
            <a class="ulink hover:text-accent" href={site.links.github} target="_blank" rel="noreferrer">github.com/{site.handle} &nearr;</a>
          </figcaption>
        </figure>
      </div>
      <div class="reveal col-span-12 mt-10 self-end font-mono text-xs text-faint min-[900px]:col-span-4 min-[900px]:col-start-9 min-[900px]:mt-0 min-[900px]:text-right">
        <b class="block text-[32px] font-normal tracking-[-0.02em] text-fg tabular-nums" data-clock="long">--:--:--</b>
        <span>{site.location} / {site.timezone}</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Dots are injected as raw markup (and replaced by the live refresh), so rect rules are global. */
  :global(#contrib rect) {
    transform-box: fill-box;
    transform-origin: center;
    transition: fill 0.6s, fill-opacity 0.6s, transform 0.15s;
  }
  :global(#contrib:not(.animating) rect[data-streak]) { fill: var(--accent); fill-opacity: 1; }
  :global(#contrib rect[data-today]) {
    fill: var(--accent);
    fill-opacity: 1;
    animation: today 2.4s ease-in-out infinite;
  }
  :global(#contrib.pre [data-dots]) { opacity: 0; }
  :global(#contrib.animating [data-dots]) { animation: bars-in 0.5s ease-out both; }
  :global(#contrib.animating rect) { transition: fill 0.6s, fill-opacity 0.6s, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); }
  :global(#contrib rect.flash),
  :global(#contrib rect.twinkle) { fill: var(--accent); fill-opacity: 1; transition-duration: 0.08s; }
  :global(#contrib rect.hot) { fill: var(--accent); fill-opacity: 1; transform: scale(1.5); }

  .xh { fill: var(--fg); opacity: 0; transition: opacity 0.15s; pointer-events: none; }
  :global(#contrib.hovering) .xh { opacity: 0.06; }

  .ph-line {
    position: absolute;
    top: 20px;
    left: 0;
    width: 1px;
    height: 77px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .ph-label {
    position: absolute;
    top: 3px;
    left: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1;
    color: var(--accent);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  :global(#contrib.sweeping) .ph-line,
  :global(#contrib.sweeping) .ph-label { opacity: 1; }

  .streak { transition: opacity 0.6s; }
  :global(#contrib.animating) .streak { opacity: 0; }

  @keyframes bars-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes today {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.7); }
  }
</style>
