---
import { site } from "../data/site";
---

<section id="hero" data-shape="portrait" class="relative flex min-h-screen flex-col justify-center pt-[110px] pb-10">
  <div class="wrap">
    <p class="intro mb-7 font-mono text-[12.5px] text-faint" style="--i:0">
      <span class="type">~/<b class="font-normal text-muted">edrich-barnard</b> &mdash; index</span><span class="caret" aria-hidden="true"></span>
    </p>
    <h1 class="intro text-[clamp(52px,8vw,116px)] leading-[0.92] font-medium tracking-[-0.045em]" style="--i:1" data-decode>{site.name}</h1>
    <p class="intro mt-7 max-w-[30em] text-[clamp(18px,1.6vw,21px)] leading-normal text-muted" style="--i:2">
      <strong class="font-medium text-fg">Full-stack software engineer.</strong>
      {site.lede}
    </p>
    <dl class="info relative mt-11 flex max-w-[640px] font-mono text-[12.5px]">
      <div class="intro-fade flex-1 py-3">
        <dt class="label mb-0.5">Based</dt>
        <dd>{site.location}</dd>
      </div>
      <div class="intro-fade flex-1 border-l border-line py-3 pl-[18px]">
        <dt class="label mb-0.5">Local time</dt>
        <dd data-clock="short">--:--</dd>
      </div>
    </dl>
    <div class="intro mt-9 flex flex-wrap items-center gap-2.5" style="--i:4">
      <a class="btn btn-solid group" href="#work">Selected work <span class="transition-transform group-hover:translate-y-0.5">&darr;</span></a>
      <a class="btn" href={`mailto:${site.email}`}>Email</a>
      <button type="button" class="ml-2 cursor-pointer font-mono text-[12.5px] text-faint" data-open-cmd>
        or press <kbd class="rounded-[2px] border border-line px-1.5 py-px text-muted">/</kbd>
      </button>
    </div>
  </div>
  <p class="intro absolute right-8 bottom-[72px] z-[1] hidden text-right font-mono text-[11.5px] text-faint min-[900px]:block" style="--i:7">
    fig. 01 &mdash; <b class="font-normal text-muted">7,000 points</b>, sampled from portrait<br />move your cursor through it
  </p>
</section>

<style>
  /* Rules above and below the info row; drawn in on load. */
  .info::before,
  .info::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }
  .info::before { top: 0; }
  .info::after { bottom: 0; }

  .caret {
    display: none;
    width: 0.6em;
    height: 1.15em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--accent);
  }

  /* Entrance - only when JS is on (no-js and reduced motion get the static page). */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not(.no-js)) .intro {
      opacity: 0;
      animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(150ms + var(--i) * 110ms) forwards;
    }
    :global(:root:not(.no-js)) .type {
      display: inline-block;
      overflow: hidden;
      width: 0;
      white-space: nowrap;
      vertical-align: bottom;
      animation: type 0.8s steps(24, end) 0.2s forwards;
    }
    :global(:root:not(.no-js)) .caret {
      display: inline-block;
      animation: blink 0.55s linear 5 forwards;
    }
    :global(:root:not(.no-js)) .info::before,
    :global(:root:not(.no-js)) .info::after {
      transform: scaleX(0);
      animation: draw 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.45s forwards;
    }
    :global(:root:not(.no-js)) .info::after { animation-delay: 0.6s; }
    :global(:root:not(.no-js)) .intro-fade {
      opacity: 0;
      animation: rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 1s forwards;
    }
    :global(:root:not(.no-js)) .intro-fade + .intro-fade { animation-delay: 1.12s; }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes type { to { width: 24ch; } }
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @keyframes draw { to { transform: scaleX(1); } }

  :global(.tick) { animation: tick 1s linear; }
  @keyframes tick {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0.25; }
  }
</style>
