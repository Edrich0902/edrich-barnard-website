---
import * as icons from "simple-icons";
import { stack } from "../data/site";

type Icon = { path: string; hex: string; title: string };
const lum = (hex: string) => {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const groups = stack.map((g) => ({
  ...g,
  items: g.items.map((item) => {
    const icon = item.icon ? ((icons as unknown as Record<string, Icon>)[item.icon] ?? null) : null;
    const l = icon ? lum(icon.hex) : 0.5;
    return { ...item, icon, hex: icon ? `#${icon.hex}` : undefined, lowDark: l < 0.06, lowLight: l > 0.7 };
  }),
}));
---

<div id="stack" class="mt-12 scroll-mt-24">
  <p class="label mb-4">Stack</p>
  <div class="border-t border-line" data-stagger>
    {
      groups.map((g) => (
        <div class="grid gap-3 border-b border-line py-3.5 sm:grid-cols-[120px_1fr] sm:gap-0">
          <span class="pt-1.5 font-mono text-xs text-faint">{g.group.toLowerCase()}</span>
          <ul class="flex flex-wrap gap-1.5">
            {g.items.map((item) => (
              <li
                class="chip group flex items-center gap-2 rounded-[2px] border border-line bg-bg/60 px-2.5 py-[5px] text-[13px] text-muted transition-colors hover:border-line-strong hover:text-fg"
                style={item.hex ? `--brand:${item.hex}` : undefined}
                data-low-dark={item.lowDark || undefined}
                data-low-light={item.lowLight || undefined}
              >
                {item.icon ? (
                  <svg viewBox="0 0 24 24" class="size-[15px] shrink-0 fill-current transition-colors" aria-hidden="true">
                    <path d={item.icon.path} />
                  </svg>
                ) : (
                  <span class="grid h-[15px] min-w-[15px] place-items-center font-mono text-[9px] leading-none font-medium tracking-tight" aria-hidden="true">
                    {item.mono}
                  </span>
                )}
                {item.name}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<style>
  .chip:hover svg { color: var(--brand, var(--accent)); }
  :global([data-theme="dark"]) .chip[data-low-dark]:hover svg,
  :global([data-theme="light"]) .chip[data-low-light]:hover svg { color: var(--fg); }
  .chip:hover > span { color: var(--accent); }
</style>
