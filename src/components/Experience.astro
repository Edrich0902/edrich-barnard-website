---
import { experience, education } from "../data/site";

const hash = (s: string) => {
  let h = 2166136261;
  for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0;
  return h.toString(16).padStart(8, "0").slice(0, 7);
};
const edu = education[0];
const rows = [
  ...experience,
  { period: edu.period, role: edu.title, company: edu.school, where: edu.where, summary: `Graduated ${edu.note.toLowerCase()}.`, highlights: [], tags: [] },
];
---

<section class="sec" id="experience" data-shape="helix">
  <div class="wrap">
    <div class="sec-head"><span class="n">03</span><h2>Experience</h2><span class="file">git log --career</span></div>
    <div class="grid-12">
      <ol class="col-span-12 min-[900px]:col-span-7 min-[900px]:col-start-6" data-stagger>
        {
          rows.map((e, i) => (
            <li class="grid gap-1 border-t border-line py-[22px] last:border-b min-[900px]:grid-cols-[74px_150px_1fr] min-[900px]:gap-5">
              <span class:list={["pt-1 font-mono text-xs", i === 0 ? "text-accent" : "text-faint"]}>{hash(e.company + e.role)}</span>
              <span class="pt-1 font-mono text-xs text-muted">{e.period.toLowerCase()}</span>
              <div>
                <h3 class="text-lg font-medium tracking-[-0.015em]">
                  {e.role} <span class="font-normal text-muted">&middot; {e.company}</span>
                </h3>
                <p class="mt-0.5 font-mono text-[11.5px] text-faint">{e.where.toLowerCase()}</p>
                <p class="mt-1 text-[15px] text-muted">{e.summary}</p>
                {e.highlights.length > 0 && (
                  <ul class="mt-2.5">
                    {e.highlights.map((h) => (
                      <li class="relative mt-1 pl-[18px] text-sm text-muted">
                        <span class:list={["absolute top-[0.62em] left-0.5 size-[5px]", i === 0 ? "bg-accent" : "bg-faint"]} />
                        {h}
                      </li>
                    ))}
                  </ul>
                )}
                {e.tags.length > 0 && (
                  <p class="mt-3 font-mono text-[11.5px] leading-relaxed text-faint">{e.tags.join(" / ").toLowerCase()}</p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="reveal col-span-12 mt-[22px] text-sm text-muted min-[900px]:col-span-7 min-[900px]:col-start-6">
        Plus side projects after hours - see selected work above. The full history is on
        <a class="ulink text-accent" href="/cv">my CV</a>.
      </p>
    </div>
  </div>
</section>
